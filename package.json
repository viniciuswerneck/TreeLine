{
  "name": "treeline-git-gui",
  "productName": "TreeLine",
  "version": "0.6.17",
  "description": "Git GUI for Linux with a familiar classic desktop workflow. Original implementation, independent.",
  "author": {
    "name": "TreeLine Contributors",
    "email": "contact@treeline.dev"
  },
  "homepage": "https://treeline.dev",
  "license": "MIT",
  "desktopName": "dev.treeline.app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "dev:sandbox": "ELECTRON_DISABLE_SANDBOX=1 ELECTRON_OZONE_PLATFORM_HINT=auto electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test:ui": "node scripts/uitest.cjs",
    "test:ui:new": "node scripts/uitest-new.cjs",
    "test:ui:search": "node scripts/codesearch-uitest.cjs",
    "test:stress": "node scripts/make-stress-repo.js 10000 && node scripts/stress.cjs",
    "fixture:repos": "node scripts/make-fixture-repos.js",
    "fixture:demo": "node scripts/make-demo-repo.js",
    "shots": "node scripts/shots.cjs",
    "shots:manual": "bash scripts/shots-run.sh",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "check:structure": "madge --circular --extensions ts,tsx src && node scripts/check-file-size.mjs"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "node-pty": "^1.1.0",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.50.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "madge": "^8.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
